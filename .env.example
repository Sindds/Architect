# Адрес сайта без слеша в конце: canonical, sitemap, ссылки в уведомлениях
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Уведомления о заявках в Telegram (необязательно). Уходит только номер заявки и источник, без имени и телефона.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Соль для хэша IP в ограничении частоты заявок
RATE_LIMIT_SALT=change-me
