{
  "name": "arcline-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:content": "node scripts/lint-content.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "docs:pdf": "tsx --import ./scripts/assets-hook.mjs scripts/make-sample-pdfs.ts",
    "leads:check": "tsx --env-file-if-exists=.env.local scripts/leads-check.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:content && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver",
      "esbuild"
    ]
  },
  "dependencies": {
    "lucide-react": "1.53.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
