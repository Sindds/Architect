# Переменные окружения ARCLINE: шаблон с заглушками.
# Локально: скопируйте в .env.local. На Vercel: Project → Settings → Environment Variables.
# Все значения — только на сервере. Префикс NEXT_PUBLIC_ есть лишь у адреса сайта: он не секрет и нужен при сборке.
# Подробности по каналам заявок — docs/INTEGRATIONS.md, проверка настроек — pnpm leads:check.

# ── Сайт ────────────────────────────────────────────────────────────────
# Боевой адрес сайта без слэша в конце: из него строятся canonical, sitemap и robots.txt.
# Где взять: домен, на который смотрит Vercel (Settings → Domains) или ваш сервер.
NEXT_PUBLIC_SITE_URL=https://arcline.example.ru

# Номер счётчика Яндекс Метрики (не секрет). Пусто — счётчика нет. Цели и настройка — docs/ADMIN-GUIDE.md.
# Где взять: metrika.yandex.ru → «Добавить счётчик» → номер в списке счётчиков. Вебвизор не включайте.
NEXT_PUBLIC_METRIKA_ID=

# ── Защита формы (обязательно в режиме client) ──────────────────────────
# Ключ подписи метки времени формы: без него в режиме client заявки не принимаются.
# Где взять: придумать случайную строку от 32 символов, например командой: openssl rand -base64 32
LEAD_TOKEN_SECRET=замените-на-случайную-строку-от-32-символов

# Соль для хэша IP в лимите частоты (5 заявок за 10 минут с одного IP). Тоже случайная строка.
RATE_LIMIT_SALT=замените-на-другую-случайную-строку

# Ключ подписи ссылок на PDF-смету (/smeta/<токен>, живут 7 дней). Без него в режиме client ссылка не выдаётся.
# Где взять: ещё одна случайная строка, openssl rand -base64 32
SMETA_SIGNING_SECRET=замените-на-третью-случайную-строку

# Сколько доверенных прокси стоит перед сайтом. Vercel, Caddy или nginx — 1. CDN плюс Caddy — 2.
TRUSTED_PROXY_HOPS=1

# ── Telegram: уведомления менеджерам (без имени и телефона) ───────────────
# Токен бота. Где взять: написать @BotFather в Telegram → /newbot → он пришлёт токен вида 123456789:AA…
TELEGRAM_BOT_TOKEN=
# Чат менеджеров. Где взять: добавить бота в группу, написать там любое сообщение, открыть
# https://api.telegram.org/bot<токен>/getUpdates и взять chat.id (у групп он начинается с минуса).
TELEGRAM_CHAT_ID=

# ── Битрикс24: заявки в CRM ───────────────────────────────────────────────
# Входящий вебхук с правом «CRM». Где взять: в портале Битрикс24 — раздел для разработчиков →
# «Входящий вебхук» → отметить права crm → скопировать ссылку вида https://портал.bitrix24.ru/rest/1/ключ/
# Ключ в ссылке — это пароль: не публикуйте его.
B24_WEBHOOK_URL=
# lead — классический режим CRM (с лидами), deal — простой (контакт + сделка). Подскажет pnpm leads:check.
B24_ENTITY=lead
# ID ответственного сотрудника (число из адреса его профиля в Битрикс24). Пусто — владелец вебхука.
B24_ASSIGNED_BY_ID=
# Источник в CRM. WEB — «Веб-сайт».
B24_SOURCE_ID=WEB

# ── 1С: заявки в базу 1С (необязательно) ─────────────────────────────────
# Адрес HTTP-сервиса базы, который принимает заявки. Где взять: его публикует программист 1С
# по контракту из docs/INTEGRATIONS.md, адрес вида https://сервер/база/hs/leads/v1/leads
ONEC_LEADS_URL=
# Пользователь 1С с правом создавать заявки (Basic-авторизация).
ONEC_USER=
ONEC_PASSWORD=

# ── Хранение заявок на сервере ────────────────────────────────────────────
# Файл .data/leads.ndjson. На Vercel файловая система только для чтения: поставьте off и используйте CRM.
LEADS_FILE=on
